# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_SERVICE_KEY=replace_with_long_random_string_min_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# In production: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
# OFF unless set to exactly '1' or 'true'. Absent, empty, '0' and 'false' = OFF.
#
# NBA_EVAL_ENABLE_PICKS gates every backend path that produces a betting
# recommendation: scripts/daily_best_picks.py, POST /api/bets/generate and
# POST /api/players/evaluate-line. Research endpoints (game logs, splits,
# matchup context) are never gated by it.
#
# Leave OFF. The prop model went 40-66 (37.7%) on 106 graded picks against real
# lines versus a 52.4% breakeven and loses to a 10-game rolling average on every
# stat. See docs/NEXT_STEPS_2026-08-23.md for the exit criteria to re-enable.
# NBA_EVAL_ENABLE_PICKS=0

# ── External APIs ─────────────────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set in frontend/.env.local — or as Vercel env vars in the dashboard
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_API_URL=https://your-app.railway.app   (leave empty for local dev — uses Vite proxy)
#
# VITE_ENABLE_PREDICTIONS is the frontend twin of NBA_EVAL_ENABLE_PICKS: it
# gates Best Bets, the prediction cards, the model edge card and line
# evaluation. Same parsing ('1'/'true' only). Leave OFF.
# VITE_ENABLE_PREDICTIONS=0
