# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_SERVICE_KEY=replace_with_long_random_string_min_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# In production: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External APIs ─────────────────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set in frontend/.env.local — or as Vercel env vars in the dashboard
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_API_URL=https://your-app.railway.app   (leave empty for local dev — uses Vite proxy)
